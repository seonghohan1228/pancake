# CLI contract: initial output is unadvanced, the final interval may be short,
# and saved temperature / rigid-body position belong to the reported time.
file(MAKE_DIRECTORY "${TEST_DIR}")
foreach(mode IN ITEMS zero partial)
    if(mode STREQUAL "zero")
        set(end_time 0)
    else()
        set(end_time 0.015)
    endif()
    set(output_dir "${TEST_DIR}/${mode}")
    set(config "${TEST_DIR}/${mode}.txt")
    file(WRITE "${config}" "R = 0.02\nc = 0.0001\ne = 0\nL = 0.04\nn_theta_global = 24\nn_z_global = 4\nomega = 100\np_cav = 100000\nbc_z_south_val = 100000\nbc_z_north_val = 100000\ncavitation_model = FBNS\nsolution_mode = TRANSIENT\ndt = 0.01\nend_t = ${end_time}\nwrite_interval = 0.01\nmu = 0.05\nrho = 950\nrho_cp = 1900000\ntemperature_model = ENERGY_EQUATION\ntemperature_initial = 300\ntemperature_reference = 300\njournal_heat_transfer = 0\nbearing_heat_transfer = 0\nmotion_model = MOVING_BEARING\nmotion_time_method = RK4\nbearing_mass = 1\nexternal_load_z = 2\noutput_write_3d = false\noutput_write_flat = true\noutput_fields = temperature, bearing_z\ndiagnostics_interval = 1\noutput_dir = ${output_dir}\n")
    execute_process(COMMAND "${SOLVER}" -c "${config}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} time case failed (${result}): ${output}\n${errors}")
    endif()
    file(READ "${output_dir}/flat/results.pvd" collection)
    string(REGEX MATCHALL "<DataSet " datasets "${collection}")
    list(LENGTH datasets count)
    file(READ "${output_dir}/flat/processor0/solution_0_0.vts" initial)
    if(NOT initial MATCHES "Name=\"T\"[^>]*>[ \r\n]*300[ \r\n]")
        message(FATAL_ERROR "Initial temperature was advanced before t=0 output")
    endif()
    if(mode STREQUAL "zero")
        if(NOT count EQUAL 1 OR EXISTS "${output_dir}/diagnostics.csv")
            message(FATAL_ERROR "end_t=0 must save only the unadvanced initial state")
        endif()
    else()
        if(NOT count EQUAL 3 OR NOT collection MATCHES "timestep=\"0.015\"")
            message(FATAL_ERROR "Expected snapshots at 0, 0.01 and 0.015: ${collection}")
        endif()
        file(READ "${output_dir}/diagnostics.csv" diagnostics)
        string(REGEX MATCHALL "\n[12],[^\n]+" rows "${diagnostics}")
        list(LENGTH rows advances)
        if(NOT advances EQUAL 2)
            message(FATAL_ERROR "Expected exactly two physical advances: ${diagnostics}")
        endif()
        file(READ "${output_dir}/flat/processor0/solution_2_0.vts" final)
        # Uniform insulated Couette heating: delta T = mu (omega R/h)^2 t / rho_cp.
        # 300 + 10.526315789... * 0.015 = 300.1578947 K (VTK stores 6 digits).
        if(NOT final MATCHES "Name=\"T\"[^>]*>[ \r\n]*300\\.158[ \r\n]")
            message(FATAL_ERROR "Final temperature does not reflect 0.015 s of heating")
        endif()
        # Decoupled axial rigid-body acceleration: z = (F_z / (2 m)) t^2.
        if(NOT final MATCHES "Name=\"xB\"[^>]*>[ \r\n]*[^ ]+ [^ ]+ 0\\.000225[ \r\n]")
            message(FATAL_ERROR "Saved rigid-body position lags the reported time")
        endif()
    endif()
endforeach()
